{
  "name": "@turystack/react-icons",
  "description": "Stable, cross-platform icon API backed by Solar Icons.",
  "private": false,
  "version": "1.0.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/web/index.js",
  "module": "./dist/web/index.js",
  "types": "./dist/web/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/mobile/index.d.ts",
        "import": "./dist/mobile/index.js",
        "default": "./dist/mobile/index.js"
      },
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "import": "./dist/mobile/index.js",
      "default": "./dist/mobile/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE-THIRD-PARTY"
  ],
  "scripts": {
    "build": "pnpm clean && vite build && tsc -p tsconfig.build.json",
    "generate": "node scripts/generate.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/turystack/react-icons.git"
  },
  "dependencies": {
    "@solar-icons/react-native": "1.1.1",
    "@solar-icons/react-perf": "2.1.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.72",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/react": "19.2.17",
    "lucide-react": "0.575.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-svg": "^15.15.5",
    "rimraf": "^6.1.3",
    "simple-icons": "^16.28.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
